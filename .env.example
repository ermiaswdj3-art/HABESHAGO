# HABESHAGO environment configuration template
#
# Copy this file to .env for local development.
# Never commit real secrets.

BOT_TOKEN=
ADMIN_ID=

# Public HTTPS URL used by Telegram to launch
# the HABESHAGO passenger Mini App.
#
# Example:
# HABESHAGO_MINI_APP_URL=https://app.habeshago.com
HABESHAGO_MINI_APP_URL=

# Optional Mini App development driver identity.
HABESHAGO_MINI_APP_DRIVER_ID=